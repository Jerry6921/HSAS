{
  "checkpoint": {
    "$defs": {
      "NotesArtifact": {
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
            "title": "Artifact Id",
            "type": "string"
          },
          "citations": {
            "items": {
              "$ref": "#/$defs/NotesCitation"
            },
            "minItems": 1,
            "title": "Citations",
            "type": "array"
          },
          "content": {
            "minLength": 1,
            "title": "Content",
            "type": "string"
          },
          "kind": {
            "enum": [
              "overview",
              "unit",
              "question-map",
              "review",
              "coverage"
            ],
            "title": "Kind",
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "artifact_id",
          "kind",
          "title",
          "content",
          "citations"
        ],
        "title": "NotesArtifact",
        "type": "object"
      },
      "NotesCitation": {
        "additionalProperties": false,
        "properties": {
          "locator": {
            "minLength": 1,
            "title": "Locator",
            "type": "string"
          },
          "source_id": {
            "title": "Source Id",
            "type": "string"
          }
        },
        "required": [
          "source_id",
          "locator"
        ],
        "title": "NotesCitation",
        "type": "object"
      },
      "NotesPublication": {
        "additionalProperties": false,
        "properties": {
          "readback_note": {
            "default": "",
            "title": "Readback Note",
            "type": "string"
          },
          "status": {
            "enum": [
              "pending",
              "failed",
              "verified"
            ],
            "title": "Status",
            "type": "string"
          },
          "target": {
            "minLength": 1,
            "title": "Target",
            "type": "string"
          },
          "url": {
            "default": "",
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "target",
          "status"
        ],
        "title": "NotesPublication",
        "type": "object"
      },
      "NotesQuestion": {
        "additionalProperties": false,
        "properties": {
          "answer_citation": {
            "anyOf": [
              {
                "$ref": "#/$defs/NotesCitation"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "answer_kind": {
            "enum": [
              "official",
              "agent-derived",
              "teaching-variant",
              "unresolved"
            ],
            "title": "Answer Kind",
            "type": "string"
          },
          "locator": {
            "minLength": 1,
            "title": "Locator",
            "type": "string"
          },
          "note": {
            "default": "",
            "title": "Note",
            "type": "string"
          },
          "question_id": {
            "minLength": 1,
            "title": "Question Id",
            "type": "string"
          },
          "scope": {
            "default": "current",
            "enum": [
              "current",
              "historical-only",
              "unmatched"
            ],
            "title": "Scope",
            "type": "string"
          },
          "source_id": {
            "title": "Source Id",
            "type": "string"
          },
          "unit_ids": {
            "items": {
              "type": "string"
            },
            "title": "Unit Ids",
            "type": "array"
          }
        },
        "required": [
          "question_id",
          "source_id",
          "locator",
          "answer_kind"
        ],
        "title": "NotesQuestion",
        "type": "object"
      },
      "NotesUnit": {
        "additionalProperties": false,
        "properties": {
          "prerequisites": {
            "items": {
              "type": "string"
            },
            "title": "Prerequisites",
            "type": "array"
          },
          "source_ids": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Source Ids",
            "type": "array"
          },
          "title": {
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "unit_id": {
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
            "title": "Unit Id",
            "type": "string"
          }
        },
        "required": [
          "unit_id",
          "title",
          "source_ids"
        ],
        "title": "NotesUnit",
        "type": "object"
      },
      "SourceReview": {
        "additionalProperties": false,
        "properties": {
          "disposition": {
            "default": "included",
            "enum": [
              "included",
              "excluded"
            ],
            "title": "Disposition",
            "type": "string"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "title": "Limitations",
            "type": "array"
          },
          "locators": {
            "items": {
              "type": "string"
            },
            "title": "Locators",
            "type": "array"
          },
          "question_inventory_complete": {
            "default": false,
            "title": "Question Inventory Complete",
            "type": "boolean"
          },
          "reading": {
            "default": "pending",
            "enum": [
              "pending",
              "read",
              "limited"
            ],
            "title": "Reading",
            "type": "string"
          },
          "reason": {
            "default": "",
            "title": "Reason",
            "type": "string"
          },
          "role": {
            "enum": [
              "unknown",
              "lecture",
              "syllabus",
              "paper",
              "quiz",
              "answer",
              "supplement"
            ],
            "title": "Role",
            "type": "string"
          },
          "source_id": {
            "title": "Source Id",
            "type": "string"
          }
        },
        "required": [
          "source_id",
          "role"
        ],
        "title": "SourceReview",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "artifacts": {
        "items": {
          "$ref": "#/$defs/NotesArtifact"
        },
        "title": "Artifacts",
        "type": "array"
      },
      "limitations": {
        "anyOf": [
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Limitations"
      },
      "publication": {
        "anyOf": [
          {
            "$ref": "#/$defs/NotesPublication"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "questions": {
        "anyOf": [
          {
            "items": {
              "$ref": "#/$defs/NotesQuestion"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Questions"
      },
      "reconciled_exports": {
        "additionalProperties": {
          "type": "string"
        },
        "title": "Reconciled Exports",
        "type": "object"
      },
      "source_reviews": {
        "items": {
          "$ref": "#/$defs/SourceReview"
        },
        "title": "Source Reviews",
        "type": "array"
      },
      "status": {
        "default": "working",
        "enum": [
          "working",
          "partial",
          "blocked",
          "complete"
        ],
        "title": "Status",
        "type": "string"
      },
      "status_note": {
        "default": "",
        "title": "Status Note",
        "type": "string"
      },
      "units": {
        "anyOf": [
          {
            "items": {
              "$ref": "#/$defs/NotesUnit"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Units"
      }
    },
    "title": "NotesCheckpoint",
    "type": "object"
  },
  "mcp_tools": {
    "create_course_notes": {
      "properties": {
        "confirmed": {
          "default": false,
          "title": "Confirmed",
          "type": "boolean"
        },
        "course_id": {
          "title": "Course Id",
          "type": "string"
        },
        "language": {
          "default": "English",
          "title": "Language",
          "type": "string"
        },
        "scope": {
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "course_id",
        "scope"
      ],
      "title": "create_course_notesArguments",
      "type": "object"
    },
    "get_course_notes": {
      "properties": {
        "artifact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Id"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        }
      },
      "title": "get_course_notesArguments",
      "type": "object"
    },
    "get_course_notes_schema": {
      "properties": {},
      "title": "get_course_notes_schemaArguments",
      "type": "object"
    },
    "read_course_note_source": {
      "properties": {
        "limit": {
          "default": 12000,
          "title": "Limit",
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "title": "Offset",
          "type": "integer"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "source_id"
      ],
      "title": "read_course_note_sourceArguments",
      "type": "object"
    },
    "save_course_notes": {
      "properties": {
        "confirmed": {
          "default": false,
          "title": "Confirmed",
          "type": "boolean"
        },
        "expected_revision": {
          "title": "Expected Revision",
          "type": "integer"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "update": {
          "additionalProperties": true,
          "title": "Update",
          "type": "object"
        }
      },
      "required": [
        "run_id",
        "expected_revision",
        "update"
      ],
      "title": "save_course_notesArguments",
      "type": "object"
    }
  },
  "schema_version": "1.0"
}
